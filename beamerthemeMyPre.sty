% newtxmath points \operator@font at its own "operators" symbol font, whose TFM
% (ntxr) no longer ships with the OTF-based newtx.  Upright math operators
% (\Pr, \operatorname, \lim, \log, ...) would then fall back to Latin Modern.
% Restore the amsmath default so they use the fontspec math roman instead.
\makeatletter
\renewcommand{\operator@font}{\mathrm}
\makeatother

\definecolor{MyPreNavy}{RGB}{50,66,116}     % #324274
\definecolor{MyPreSubNavy}{RGB}{87,101,139} % #57658B

\IfFontExistsTF{Times New Roman}{%
  \setmainfont{Times New Roman}
  \setsansfont{Times New Roman}
  \setmonofont{Times New Roman}
}{%
  \setmainfont{TeX Gyre Termes}
  \setsansfont{TeX Gyre Termes}
  \setmonofont{TeX Gyre Termes}
}

\IfFontExistsTF{KaiTi}{%
  \setCJKmainfont[AutoFakeBold=2.2]{KaiTi}
  \setCJKsansfont[AutoFakeBold=2.2]{KaiTi}
  \setCJKmonofont{KaiTi}
}{%
  \setCJKmainfont[AutoFakeBold=2.2]{AR PL KaitiM GB}
  \setCJKsansfont[AutoFakeBold=2.2]{AR PL KaitiM GB}
  \setCJKmonofont{AR PL KaitiM GB}
}

\usefonttheme{serif}

\setbeamercolor{normal text}{fg=black,bg=white}
\setbeamercolor{structure}{fg=MyPreNavy}
\setbeamercolor{alerted text}{fg=MyPreNavy}
\setbeamercolor{frametitle}{fg=MyPreNavy,bg=white}
\setbeamertemplate{navigation symbols}{}
\setbeamersize{text margin left=8mm,text margin right=8mm}

\setbeamertemplate{itemize item}{\raise0.15ex\hbox{\scriptsize$\blacktriangleright$}}
\setbeamertemplate{itemize subitem}{\raise0.1ex\hbox{\tiny$\bullet$}}
\setbeamercolor{itemize item}{fg=MyPreNavy}
\setbeamercolor{itemize subitem}{fg=MyPreSubNavy}
\setbeamercolor{block title}{fg=white,bg=MyPreNavy}
\setbeamercolor{block body}{fg=black,bg=MyPreNavy!5}
\setbeamercolor{block title alerted}{fg=white,bg=MyPreSubNavy}
\setbeamercolor{block body alerted}{fg=black,bg=MyPreSubNavy!6}
\setbeamerfont{block title}{series=\bfseries}

\NewDocumentEnvironment{MyPreContent}{O{top} O{left}}{%
  \def\MyPreContentVAlign{#1}%
  \def\MyPreContentHAlign{#2}%
  \ifstrequal{\MyPreContentVAlign}{center}{\vfill}{}%
  \ifstrequal{\MyPreContentHAlign}{center}{\centering}{\raggedright}%
}{%
  \par%
  \ifstrequal{\MyPreContentVAlign}{center}{\vfill}{}%
}

\setbeamertemplate{title page}{%
  \begin{tikzpicture}[remember picture,overlay]
    \fill[MyPreNavy]
      ([yshift=-19.8mm]current page.north west)
      rectangle
      ([yshift=-52.9mm]current page.north east);

    \node[
      anchor=center,
      align=center,
      text=white,
      text width=.92\paperwidth,
      font=\fontsize{26}{31}\selectfont
    ] at ([yshift=-36.35mm]current page.north) {\inserttitle};

    \node[
      anchor=center,
      align=center,
      text=MyPreNavy,
      font=\fontsize{12.5}{15}\selectfont
    ] at ([yshift=24mm]current page.south) {Presenter: \insertauthor};

    \node[
      anchor=center,
      align=center,
      text=MyPreNavy,
      font=\bfseries\fontsize{13.5}{16}\selectfont
    ] at ([yshift=15.5mm]current page.south) {\insertdate};
  \end{tikzpicture}%
}

\newcommand{\MyPreSectionLabel}{\Roman{section}.\ \insertsectionhead}

\setbeamertemplate{frametitle}{%
  \nointerlineskip
  \begin{beamercolorbox}[wd=\paperwidth,ht=17.4mm,dp=0mm]{frametitle}
    \begin{tikzpicture}[remember picture,overlay]
      \fill[MyPreNavy]
        ([xshift=1.45mm,yshift=-1.55mm]current page.north west)
        rectangle ++(1.75mm,-5.65mm);

      \node[
        anchor=north west,
        inner sep=0pt,
        text=MyPreNavy,
        font=\bfseries\fontsize{15.7}{18.7}\selectfont
      ] at ([xshift=4.0mm,yshift=-2.25mm]current page.north west)
        {\ifnum\value{section}=0\relax\insertframetitle\else\MyPreSectionLabel\fi};

      \ifnum\value{section}>0\relax
        \node[
          anchor=north west,
          inner sep=0pt,
          text=MyPreSubNavy,
          font=\bfseries\fontsize{11.1}{13.3}\selectfont
        ] at ([xshift=2.15mm,yshift=-10.9mm]current page.north west)
          {\insertframetitle};
      \fi
    \end{tikzpicture}
  \end{beamercolorbox}%
}

\makeatletter
\newcommand{\MyPreRomanNumber}[1]{\@Roman{#1}}
\makeatother

\setbeamerfont{section in toc}{size=\normalsize,series=\bfseries}
\setbeamerfont{subsection in toc}{size=\small,series=\mdseries}
\setbeamercolor{section in toc}{fg=MyPreNavy}
\setbeamercolor{subsection in toc}{fg=MyPreSubNavy}

\setbeamertemplate{section in toc}{%
  \leavevmode\MyPreRomanNumber{\inserttocsectionnumber}.\hspace{0.55em}%
  \inserttocsection\par%
  \vspace{0.45ex}%
}

\setbeamertemplate{subsection in toc}{%
  \leavevmode\hbox{\scriptsize$\blacktriangleright$}\hspace{0.55em}%
  \inserttocsubsection\par%
  \vspace{0.24ex}%
}

% -----------------------------------------------------------------------------
% Contents page
% -----------------------------------------------------------------------------
%
% beamer puts a \vfill in front of every first-level entry of the contents list
% (\beamer@sectionintoc in beamerbasetoc.sty).  Those \vfill s absorb the whole
% leftover height of the frame and spread the list out over it, which defeats
% both the [t] frame option and any attempt to balance the list in columns.
% Replacing them with a fixed skip makes the contents list behave like ordinary
% content, so "[t]" top-aligns it and multicols can balance it.
%
% Retune by redefining \MyPreTocSectionSkip in your preamble, e.g.
%   \MyPreTocSectionSkip=1.0em
\newdimen\MyPreTocSectionSkip
\MyPreTocSectionSkip=1.2em

\makeatletter
\AtBeginDocument{%
  \patchcmd{\beamer@sectionintoc}{\vfill}{\vskip\MyPreTocSectionSkip}{}{%
    \PackageWarning{beamerthemeMyPre}{%
      Cannot patch \string\beamer@sectionintoc; the contents list may be
      stretched vertically instead of top-aligned}%
  }%
}
\makeatother

\newsavebox{\MyPreTocScratchBox}
\newcount\MyPreTocSecCount
\newcount\MyPreTocSubCount
\newdimen\MyPreTocSecLine
\newdimen\MyPreTocSubLine
\newdimen\MyPreTocEstimated
\newdimen\MyPreTocAvailable
\newif\ifMyPreTocTwoColumns
% Set \MyPreTocDebugtrue in your preamble to see how the layout is chosen.
\newif\ifMyPreTocDebug

\makeatletter
% Count the entries by re-reading the .toc file with counting stand-ins for the
% macros beamer writes into it.  (Measuring the typeset list in a box is not an
% option: \beamer@sectionintoc expands through \only + \gdef, which breaks
% outside beamer's overlay context.)
\def\MyPre@tocCountSec#1#2#3#4#5{\global\advance\MyPreTocSecCount\@ne}
\def\MyPre@tocCountSub#1#2#3#4#5#6{\global\advance\MyPreTocSubCount\@ne}

\newcommand{\MyPre@tocCount}{%
  \MyPreTocSecCount\z@ \MyPreTocSubCount\z@
  \IfFileExists{\jobname.toc}{%
    \begingroup
      % The .toc file spells its entries \beamer@sectionintoc / \beamer@...
      % so "@" has to be a letter while the file is read -- same trick beamer
      % itself uses around \@input in \beamer@tableofcontents.
      \makeatletter
      \let\beamer@sectionintoc\MyPre@tocCountSec
      \let\beamer@subsectionintoc\MyPre@tocCountSub
      \input{\jobname.toc}%
    \endgroup
  }{}%
}

% Height of one entry: the line box at that entry's own font size plus the
% trailing \vspace used by the two templates above.  Section titles long enough
% to wrap are counted as one line, which only makes the estimate optimistic.
\newcommand{\MyPre@tocEntryHeights}{%
  \begingroup
    \usebeamerfont{section in toc}%
    \setbox\MyPreTocScratchBox\hbox{\strut}%
    \global\MyPreTocSecLine\dimexpr\ht\MyPreTocScratchBox+\dp\MyPreTocScratchBox+0.45ex\relax
  \endgroup
  \begingroup
    \usebeamerfont{subsection in toc}%
    \setbox\MyPreTocScratchBox\hbox{\strut}%
    \global\MyPreTocSubLine\dimexpr\ht\MyPreTocScratchBox+\dp\MyPreTocScratchBox+0.24ex\relax
  \endgroup
}

\newcommand{\MyPre@tocDecide}{%
  \MyPre@tocCount
  \MyPre@tocEntryHeights
  % The inter-section skip separates sections, so there are (n-1) of them; the
  % one the patch would otherwise add in front of the first section is already
  % covered by beamer's own \vspace*{-.5em} in \beamer@tableofcontents.
  \count@\MyPreTocSecCount
  \ifnum\count@>\z@ \advance\count@\m@ne \fi
  \MyPreTocEstimated\dimexpr
      \MyPreTocSecCount\MyPreTocSecLine
    + \MyPreTocSubCount\MyPreTocSubLine
    + \count@\MyPreTocSectionSkip
    \relax
  % \textheight is the frame body, and the frame title box sits inside it.
  \MyPreTocAvailable\dimexpr\textheight-17.4mm-6mm\relax
  \ifdim\MyPreTocEstimated>\MyPreTocAvailable
    \MyPreTocTwoColumnstrue
  \else
    \MyPreTocTwoColumnsfalse
  \fi
  % Warn when even two columns would not be enough, i.e. when the list split
  % over two columns is taller per column than the space available.
  % Half-width columns make long titles wrap, which the one-line-per-entry
  % estimate above does not account for, but the estimate is itself ~4%
  % pessimistic, which covers that.
  \ifdim\MyPreTocEstimated>2\MyPreTocAvailable
    \PackageWarning{beamerthemeMyPre}{%
      Contents list is long (\the\MyPreTocSecCount\space sections,
      \the\MyPreTocSubCount\space subsections).  It will not fit on one slide
      even in two columns; split it explicitly with
      \string\MyPreTOC[sections={1-N}] and continue with
      \string\MyPreTOC[sections={N+1-M}]}%
  \fi
  \ifMyPreTocDebug
    \typeout{MyPreTOC: \the\MyPreTocSecCount\space sections,
      \the\MyPreTocSubCount\space subsections; section line
      \the\MyPreTocSecLine, subsection line \the\MyPreTocSubLine, skip
      \the\MyPreTocSectionSkip; estimated \the\MyPreTocEstimated, available
      \the\MyPreTocAvailable, two-columns=\ifMyPreTocTwoColumns yes\else no\fi}%
  \fi
}
\makeatother

% \MyPreTOC            -- one column, or two when the list does not fit
% \MyPreTOC[sections={1-4}]  -- pass options straight through to \tableofcontents
\makeatletter
\NewDocumentCommand{\MyPreTOC}{O{}}{%
  \ifstrequal{#1}{}{%
    \MyPre@tocDecide
    \ifMyPreTocTwoColumns
      \begin{multicols}{2}%
        \tableofcontents
      \end{multicols}%
    \else
      \tableofcontents
    \fi
  }{%
    \tableofcontents[#1]%
  }%
}
\makeatother

\setbeamerfont{page number in head/foot}{size*={12pt}{12pt},series=\bfseries}
\setbeamercolor{page number in head/foot}{fg=MyPreNavy,bg=white}
\setbeamertemplate{footline}{%
  \leavevmode%
  \hbox{%
    \begin{beamercolorbox}[
      wd=\paperwidth,
      ht=6.4mm,
      dp=1.9mm,
      rightskip=4.2mm
    ]{page number in head/foot}%
      \hfill\usebeamerfont{page number in head/foot}\insertframenumber
    \end{beamercolorbox}%
  }%
}

\mode<all>
