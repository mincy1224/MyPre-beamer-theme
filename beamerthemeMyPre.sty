\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{beamerthemeMyPre}[2026/09/20 MyPre Beamer theme]

\mode<presentation>

\RequirePackage{tikz}
\RequirePackage{fontspec}
\RequirePackage{xeCJK}
\RequirePackage{amsmath,amssymb,mathtools}
\RequirePackage{newtxmath}
\RequirePackage{etoolbox}
\RequirePackage{xparse}

\definecolor{MyPreNavy}{RGB}{50,66,116}     % #324274
\definecolor{MyPreSubNavy}{RGB}{87,101,139} % #57658B

\IfFontExistsTF{Times New Roman}{%
  \setmainfont{Times New Roman}
  \setsansfont{Times New Roman}
  \setmonofont{Times New Roman}
}{%
  \setmainfont{TeXGyreTermes}
  \setsansfont{TeXGyreTermes}
  \setmonofont{TeXGyreTermes}
}

\IfFontExistsTF{KaiTi}{%
  \setCJKmainfont[AutoFakeBold=2.2]{KaiTi}
  \setCJKsansfont[AutoFakeBold=2.2]{KaiTi}
  \setCJKmonofont{KaiTi}
}{%
  \setCJKmainfont[AutoFakeBold=2.2]{AR PL KaitiM GB}
  \setCJKsansfont[AutoFakeBold=2.2]{AR PL KaitiM GB}
  \setCJKmonofont{AR PL KaitiM GB}
}

\usefonttheme{serif}

\setbeamercolor{normal text}{fg=black,bg=white}
\setbeamercolor{structure}{fg=MyPreNavy}
\setbeamercolor{alerted text}{fg=MyPreNavy}
\setbeamercolor{frametitle}{fg=MyPreNavy,bg=white}
\setbeamertemplate{navigation symbols}{}
\setbeamersize{text margin left=8mm,text margin right=8mm}

\setbeamertemplate{itemize item}{\raise0.15ex\hbox{\scriptsize$\blacktriangleright$}}
\setbeamertemplate{itemize subitem}{\raise0.1ex\hbox{\tiny$\bullet$}}
\setbeamercolor{itemize item}{fg=MyPreNavy}
\setbeamercolor{itemize subitem}{fg=MyPreSubNavy}
\setbeamercolor{block title}{fg=white,bg=MyPreNavy}
\setbeamercolor{block body}{fg=black,bg=MyPreNavy!5}
\setbeamercolor{block title alerted}{fg=white,bg=MyPreSubNavy}
\setbeamercolor{block body alerted}{fg=black,bg=MyPreSubNavy!6}
\setbeamerfont{block title}{series=\bfseries}

\NewDocumentEnvironment{MyPreContent}{O{top} O{left}}{%
  \def\MyPreContentVAlign{#1}%
  \def\MyPreContentHAlign{#2}%
  \ifstrequal{\MyPreContentVAlign}{center}{\vfill}{}%
  \ifstrequal{\MyPreContentHAlign}{center}{\centering}{\raggedright}%
}{%
  \par%
  \ifstrequal{\MyPreContentVAlign}{center}{\vfill}{}%
}

\setbeamertemplate{title page}{%
  \begin{tikzpicture}[remember picture,overlay]
    \fill[MyPreNavy]
      ([yshift=-19.8mm]current page.north west)
      rectangle
      ([yshift=-52.9mm]current page.north east);

    \node[
      anchor=center,
      align=center,
      text=white,
      text width=.92\paperwidth,
      font=\fontsize{26}{31}\selectfont
    ] at ([yshift=-36.35mm]current page.north) {\inserttitle};

    \node[
      anchor=center,
      align=center,
      text=MyPreNavy,
      font=\fontsize{12.5}{15}\selectfont
    ] at ([yshift=24mm]current page.south) {Presenter: \insertauthor};

    \node[
      anchor=center,
      align=center,
      text=MyPreNavy,
      font=\bfseries\fontsize{13.5}{16}\selectfont
    ] at ([yshift=15.5mm]current page.south) {\insertdate};
  \end{tikzpicture}%
}

\newcommand{\MyPreSectionLabel}{\Roman{section}.\ \insertsectionhead}

\setbeamertemplate{frametitle}{%
  \nointerlineskip
  \begin{beamercolorbox}[wd=\paperwidth,ht=17.4mm,dp=0mm]{frametitle}
    \begin{tikzpicture}[remember picture,overlay]
      \fill[MyPreNavy]
        ([xshift=1.45mm,yshift=-1.55mm]current page.north west)
        rectangle ++(1.75mm,-5.65mm);

      \node[
        anchor=north west,
        inner sep=0pt,
        text=MyPreNavy,
        font=\bfseries\fontsize{15.7}{18.7}\selectfont
      ] at ([xshift=4.0mm,yshift=-2.25mm]current page.north west)
        {\ifnum\value{section}=0\relax\insertframetitle\else\MyPreSectionLabel\fi};

      \ifnum\value{section}>0\relax
        \node[
          anchor=north west,
          inner sep=0pt,
          text=MyPreSubNavy,
          font=\bfseries\fontsize{11.1}{13.3}\selectfont
        ] at ([xshift=2.15mm,yshift=-10.9mm]current page.north west)
          {\insertframetitle};
      \fi
    \end{tikzpicture}
  \end{beamercolorbox}%
}

\makeatletter
\newcommand{\MyPreRomanNumber}[1]{\@Roman{#1}}
\makeatother

\setbeamerfont{section in toc}{size=\normalsize,series=\bfseries}
\setbeamerfont{subsection in toc}{size=\small,series=\mdseries}
\setbeamercolor{section in toc}{fg=MyPreNavy}
\setbeamercolor{subsection in toc}{fg=MyPreSubNavy}

\setbeamertemplate{section in toc}{%
  \leavevmode\MyPreRomanNumber{\inserttocsectionnumber}.\hspace{0.55em}%
  \inserttocsection\par%
  \vspace{0.45ex}%
}

\setbeamertemplate{subsection in toc}{%
  \leavevmode\hbox{\scriptsize$\blacktriangleright$}\hspace{0.55em}%
  \inserttocsubsection\par%
  \vspace{0.24ex}%
}

\setbeamerfont{page number in head/foot}{size*={12pt}{12pt},series=\bfseries}
\setbeamercolor{page number in head/foot}{fg=MyPreNavy,bg=white}
\setbeamertemplate{footline}{%
  \leavevmode%
  \hbox{%
    \begin{beamercolorbox}[
      wd=\paperwidth,
      ht=6.4mm,
      dp=1.9mm,
      rightskip=4.2mm
    ]{page number in head/foot}%
      \hfill\usebeamerfont{page number in head/foot}\insertframenumber
    \end{beamercolorbox}%
  }%
}

\mode<all>
